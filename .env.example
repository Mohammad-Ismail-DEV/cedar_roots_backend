PORT=3000
NODE_ENV=development
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=cedar_roots_db
DB_HOST=127.0.0.1
# Gmail used to send verification emails. Turn on 2-Step Verification, then create an
# App Password at https://myaccount.google.com/apppasswords (not your normal password).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Dev only: set to "console" to print verification codes in the server log instead of emailing.
# EMAIL_MODE=console
# Path to the Firebase service account JSON (defaults to ./firebase-settings.json)
FIREBASE_SERVICE_ACCOUNT=
# Set to false once the app sends the JWT in the socket handshake (auth: { token })
ALLOW_ANON_SOCKETS=true

# Optional: SHA-256 fingerprints of the Android signing keys (comma separated) so shared links open the app
ANDROID_CERT_SHA256=
